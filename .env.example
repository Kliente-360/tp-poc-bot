# Anthropic
ANTHROPIC_API_KEY=

# Salesforce (sandbox tp-dev)
# ATENCAO: Client Credentials exige o My Domain da org.
# login/test.salesforce.com devolve "request not supported on this domain".
SF_LOGIN_URL=https://totalpass--service.sandbox.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Tenant
TENANT_ID=totalpass

# Metricas: token do endpoint /api/metricas.
# Sem ele o endpoint responde 503 — falha fechado, nao aberto.
METRICS_TOKEN=

# Rate limiting por IP. Os padroes valem se as variaveis nao existirem.
# LIMITE_MENSAGENS=30            mensagens por IP
# LIMITE_MENSAGENS_JANELA_S=600  na janela de 10 minutos
# LIMITE_CHAMADOS=3              chamados por IP
# LIMITE_CHAMADOS_JANELA_S=3600  na janela de 1 hora

# --- Acesso (SSO Google) ---
# Credenciais do cliente OAuth criado no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Assina o cookie de sessao. Minimo 32 caracteres.
# Trocar este valor invalida todas as sessoes ativas.
SESSION_SECRET=

# Quem pode entrar. Sem nenhuma das duas, ninguem entra — falha fechado.
# Dominios separados por virgula, sem @.
DOMINIOS_PERMITIDOS=kliente360.com,totalpass.com.br
# Convidados avulsos, para nao precisar abrir um dominio inteiro.
EMAILS_PERMITIDOS=

# So se um proxy reescrever o host e a URL de callback sair errada.
# AUTH_BASE_URL=https://tp-poc-bot.netlify.app
